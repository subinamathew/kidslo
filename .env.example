# Echo Kids Kiosk – Google Form Configuration Template
# Copy these variable names into your Netlify Dashboard (Site configuration > Environment variables)
# and paste your real values there.

# Google Form ID (from https://docs.google.com/forms/d/e/<FORM_ID>/viewform)
GOOGLE_FORM_ID=your_google_form_id_here

# Exact Google Form entry field IDs (e.g., entry.123456789)
ENTRY_KID_NAME=your_entry_kid_name_id_here
ENTRY_PARENT_NAME=your_entry_parent_name_id_here
ENTRY_PARENT_PHONE=your_entry_parent_phone_id_here
ENTRY_PICKUP_PERMISSION=your_entry_pickup_permission_id_here
ENTRY_PICKUP_CODE=your_entry_pickup_code_id_here
ENTRY_CONSENT=your_entry_consent_id_here
